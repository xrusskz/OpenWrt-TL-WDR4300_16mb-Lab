name: OpenWrt_25.12.5_TL-WDR4300v1_16MB_v2.5.usb.AI

on:
  workflow_dispatch:
    inputs:
      confirm_model:
        description: 'Подтверждение: физический роутер TL-WDR4300 v1'
        required: true
        default: 'TL-WDR4300 v1'
      include_python:
        description: 'Добавить Python3/PIP (увеличивает размер образа)'
        required: true
        default: 'true'

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 480

    steps:
      - name: Install build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            build-essential clang flex bison g++ gawk \
            gcc-multilib g++-multilib gettext git \
            libncurses-dev libssl-dev libelf-dev \
            python3 python3-setuptools python3-dev \
            curl rsync swig unzip zlib1g-dev \
            file wget device-tree-compiler \
            u-boot-tools ccache

      - name: Verify selected hardware
        run: |
          MODEL="${{ github.event.inputs.confirm_model }}"
          if [ "$MODEL" != "TL-WDR4300 v1" ]; then
            echo "::error::Этот workflow предназначен только для физического TL-WDR4300 v1."
            exit 1
          fi

      - name: Clone OpenWrt 25.12.5
        run: |
          git clone --branch v25.12.5 --depth 1 https://github.com/openwrt/openwrt.git
          cd openwrt
          echo "HEAD:     $(git rev-parse HEAD)"
          echo "Describe: $(git describe --always --tags)"
          echo "Log:      $(git log -1 --oneline)"

      - name: Locate WDR4300 DTS and image definitions
        run: |
          set -e
          echo "===== WDR4300 DTS/DTSI ====="
          find openwrt/target/linux/ath79/dts \
            \( -iname "*wdr4300*" -o -iname "*wdrxxxx*" \) -print

          echo "===== Old firmware layout ====="
          grep -RIn "0x020000.*0x7d0000\|0x7d0000" \
            openwrt/target/linux/ath79/dts || true

          echo "===== Old ART ====="
          grep -RIn "partition@7f0000\|0x7f0000" \
            openwrt/target/linux/ath79/dts || true

          echo "===== WDR4300 v1 image profile ====="
          grep -RIn "define Device/tplink_tl-wdr4300-v1" \
            openwrt/target/linux/ath79/image || true

      - name: Patch WDR4300 v1 image type 8MB -> 16MB
        shell: bash
        run: |
          set -euo pipefail
          FILE="openwrt/target/linux/ath79/image/generic-tp-link.mk"

          test -f "$FILE" || {
            echo "::error::Не найден $FILE"
            exit 1
          }

          echo "===== BEFORE ====="
          sed -n '/define Device\/tplink_tl-wdr4300-v1$/,/^endef$/p' "$FILE"

          sed -i \
            '/define Device\/tplink_tl-wdr4300-v1$/,/^endef$/ s/\$(Device\/tplink-8mlzma)/\$(Device\/tplink-16mlzma)/' \
            "$FILE"

          echo "===== AFTER ====="
          sed -n '/define Device\/tplink_tl-wdr4300-v1$/,/^endef$/p' "$FILE"

          sed -n '/define Device\/tplink_tl-wdr4300-v1$/,/^endef$/p' "$FILE" |
            grep -q '\$(Device/tplink-16mlzma)' || {
              echo "::error::WDR4300 v1 не переведён на tplink-16mlzma"
              exit 1
            }

      - name: Patch WDR4300 flash layout to 16MB
        shell: bash
        run: |
          set -euo pipefail

          # Отключаем pipefail, чтобы head -n1 не вызывал Broken pipe у grep
          set +o pipefail
          FILE=$(grep -RIlE '0x020000[[:space:]]+0x7d0000' \
            openwrt/target/linux/ath79/dts | head -n1 || true)
          set -o pipefail

          if [ -z "$FILE" ]; then
            echo "::error::Не найден DTS/DTSI со старой 8MB разметкой."
            exit 1
          fi

          echo "Патчим: $FILE"

          # firmware: 0x020000 + 0xfd0000 = 0xff0000
          sed -i -E \
            's/0x020000[[:space:]]+0x7d0000/0x020000 0xfd0000/' "$FILE"

          # ART: 0x7f0000 -> 0xff0000, размер 0x10000
          sed -i 's/partition@7f0000/partition@ff0000/g' "$FILE"
          sed -i -E \
            's/0x7f0000[[:space:]]+0x010000/0xff0000 0x010000/' "$FILE"

          echo "===== PATCHED PARTITIONS ====="
          grep -nE \
            'partition@|firmware|art|0x020000|0xfd0000|0xff0000|0x010000' \
            "$FILE" || true

          grep -qE '0x020000[[:space:]]+0xfd0000' "$FILE" || {
            echo "::error::Firmware partition не переведён на 16MB"
            exit 1
          }

          grep -q 'partition@ff0000' "$FILE" || {
            echo "::error::ART partition не перемещён в 0xff0000"
            exit 1
          }

          grep -qE '0xff0000[[:space:]]+0x010000' "$FILE" || {
            echo "::error::ART size/offset неверны"
            exit 1
          }

      - name: Patch IMAGE_SIZE
        shell: bash
        run: |
          set -euo pipefail

          # Отключаем pipefail для связки grep + head -n1
          set +o pipefail
          MKFILE=$(grep -Rl "tplink_tl-wdr4300-v1" \
            openwrt/target/linux/ath79/image | head -n1 || true)
          set -o pipefail

          if [ -z "$MKFILE" ]; then
            echo "::error::Не найден image Makefile WDR4300"
            exit 1
          fi

          echo "Using: $MKFILE"
          grep -n "IMAGE_SIZE" "$MKFILE" || true

          sed -i -E \
            's/(IMAGE_SIZE[[:space:]]*:?=[[:space:]]*)[0-9]+k/\116128k/' \
            "$MKFILE"

          grep -q "16128k" "$MKFILE" || {
            echo "::error::IMAGE_SIZE != 16128k"
            exit 1
          }

      - name: Cache OpenWrt downloads
        uses: actions/cache@v4
        with:
          path: openwrt/dl
          key: openwrt-25.12.5-ath79-${{ runner.os }}-${{ runner.arch }}-dl
          restore-keys: |
            openwrt-25.12.5-ath79-${{ runner.os }}-${{ runner.arch }}-
            openwrt-25.12.5-ath79-

      - name: Cache ccache
        uses: actions/cache@v4
        with:
          path: ~/.ccache
          key: openwrt-25.12.5-ath79-${{ runner.os }}-${{ runner.arch }}-ccache
          restore-keys: |
            openwrt-25.12.5-ath79-${{ runner.os }}-${{ runner.arch }}-ccache

      - name: Update feeds
        working-directory: openwrt
        run: |
          ./scripts/feeds update -a
          ./scripts/feeds install -a

      - name: Configure OpenWrt
        working-directory: openwrt
        run: |
          set -euo pipefail

          echo "CONFIG_TARGET_ath79=y" > .config
          echo "CONFIG_TARGET_ath79_generic=y" >> .config
          echo "CONFIG_TARGET_ath79_generic_DEVICE_tplink_tl-wdr4300-v1=y" >> .config

          # Build
          echo "CONFIG_DEVEL=y" >> .config
          echo "CONFIG_CCACHE=y" >> .config

          # ==========================================================
          # РУССКИЙ ЯЗЫК / LUCi
          # ==========================================================
          echo "CONFIG_PACKAGE_luci=y" >> .config
          echo "CONFIG_PACKAGE_uhttpd=y" >> .config
          echo "CONFIG_PACKAGE_luci-ssl=y" >> .config
          echo "CONFIG_PACKAGE_luci-i18n-base-ru=y" >> .config
          echo "CONFIG_PACKAGE_luci-i18n-opkg-ru=y" >> .config
          echo "CONFIG_PACKAGE_luci-i18n-firewall-ru=y" >> .config
          echo "CONFIG_PACKAGE_luci-theme-bootstrap=y" >> .config
          echo "CONFIG_PACKAGE_luci-theme-material=y" >> .config

          # Русская локаль/локализация CLI
          echo "CONFIG_PACKAGE_zoneinfo-asia=y" >> .config
          echo "CONFIG_PACKAGE_libustream-openssl=y" >> .config

          # ==========================================================
          # USB / STORAGE
          # ==========================================================
          echo "CONFIG_PACKAGE_kmod-usb-storage=y" >> .config
          echo "CONFIG_PACKAGE_kmod-scsi-core=y" >> .config
          echo "CONFIG_PACKAGE_kmod-scsi-generic=y" >> .config
          echo "CONFIG_PACKAGE_usbutils=y" >> .config

          # Filesystems
          echo "CONFIG_PACKAGE_kmod-fs-ext4=y" >> .config
          echo "CONFIG_PACKAGE_kmod-fs-vfat=y" >> .config
          echo "CONFIG_PACKAGE_dosfstools=y" >> .config
          echo "CONFIG_PACKAGE_kmod-fs-exfat=y" >> .config
          echo "CONFIG_PACKAGE_exfatprogs=y" >> .config
          echo "CONFIG_PACKAGE_kmod-fs-ntfs3=y" >> .config
          echo "CONFIG_PACKAGE_ntfs3-mount=y" >> .config

          # extroot/block
          echo "CONFIG_PACKAGE_block-mount=y" >> .config

          # Опциональный Python 3
          if [ "${{ github.event.inputs.include_python }}" = "true" ]; then
            echo "CONFIG_PACKAGE_python3=y" >> .config
            echo "CONFIG_PACKAGE_python3-pip=y" >> .config
          fi

          # Генерация финального конфига
          make defconfig

      - name: Show ccache statistics
        run: ccache -s || true

      - name: Verify final DTB and partition layout
        shell: bash
        run: |
          # ВРЕМЕННО ОТКЛЮЧАЕМ pipefail ИЗ-ЗА GREP + HEAD
          set -eu
          set +o pipefail

          echo "===== SEARCH DTB ====="
          DTB_FILE=$(find openwrt/target/linux/ath79/dts -name "*wdr4300*" | head -n 1)
          
          if [ -n "$DTB_FILE" ]; then
            echo "Проверяем файл: $DTB_FILE"
            grep -A 2 -B 2 "firmware" "$DTB_FILE" || true
            grep -A 2 -B 2 "art" "$DTB_FILE" || true
          else
            echo "DTS файл не найден для финальной верификации!"
          fi
          
          # ВОЗВРАЩАЕМ pipefail ОБРАТНО
          set -o pipefail

      - name: Compile firmware
        working-directory: openwrt
        run: |
          make -j$(nproc) || make -j1 V=s

      - name: Upload Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: OpenWrt_25.12.5_TL-WDR4300v1_16MB_v2.5.usb.AI
          path: out/
          retention-days: 30
